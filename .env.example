# Environment variables template for Sentinel / BurstGuard
# Copy to .env and fill in if needed.

# Optional — enables LLM-generated investigation memos.
# Without this, Sentinel falls back to a fully grounded template memo
BURSTGUARD_LLM_API_KEY=
BURSTGUARD_LLM_PROVIDER=gemini

# Optional — Razorpay Test Mode keys (sandbox only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
